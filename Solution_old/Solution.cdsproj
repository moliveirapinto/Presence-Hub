<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(Pkg_Microsoft_PowerApps_MSBuild_Solution)\build\Microsoft.PowerApps.MSBuild.Solution.targets</PowerAppsTargetsPath>
    <SolutionPackageType>Managed</SolutionPackageType>
    <SolutionPackageMapFilePath>$(MSBuildThisFileDirectory)\src\Other\Solution.xml</SolutionPackageMapFilePath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <ProjectGuid>b8f3e2a1-4c7d-9e0f-1a2b-3c4d5e6f7a8b</ProjectGuid>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <NuGetPackageRoot>$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*" />
    <ProjectReference Include="..\Presence-Hub.pcfproj" />
  </ItemGroup>
  <Import Project="$(PowerAppsTargetsPath)" />
</Project>
